build --action_env=ZERO_AR_DATE=1

# Forward PATH into actions. Without this, Bazel genrules (third-party/td's
# td_build in particular) don't see tools installed via `brew install` on the
# CI runner even though --spawn_strategy=standalone means the action isn't
# sandboxed - Bazel still substitutes its own fixed default PATH for actions
# unless told to pass the invoking shell's PATH through. Confirmed locally:
# td's CMake generate step calls gperf, brew puts it on /opt/homebrew/bin, and
# without this line the genrule's cmd_bash never sees it on PATH regardless.
build --action_env=PATH

build --enable_platform_specific_config

# Download dependencies directly if the remote downloader configured by --cacheHost fails.
build --experimental_remote_downloader_local_fallback

# Keeps $(TARGET_CPU) as "ios_sim_arm64" rather than "aarch64". Removing this does not
# fail the build: the third-party genrules silently pick the wrong build directory.
build --noincompatible_target_cpu_from_platform

# macOS-specific settings (auto-applied on macOS via --enable_platform_specific_config)
build:macos --features=debug_prefix_map_pwd_is_dot
build:macos --features=swift.cacheable_swiftmodules
build:macos --features=swift.debug_prefix_map
build:macos --features=swift.enable_vfsoverlays
build:dbg --features=swift.emit_swiftsourceinfo

# Linux-specific settings (auto-applied on Linux via --enable_platform_specific_config)
build:linux --action_env=CC
build:linux --action_env=CXX

build --strategy=Genrule=standalone
build --spawn_strategy=standalone

build:macos --strategy=SwiftCompile=worker

common:macos --features=swift.use_global_module_cache
common:macos --features=oso_prefix_is_pwd
